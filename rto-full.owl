    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000001 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000968"/>
        <obo:IAO_0000115>A device that limits the 2D spatial extent of the fluence of subatomic particles.</obo:IAO_0000115>
        <rdfs:isDefinedBy>Mark Phillips</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">collimator</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000002 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000968"/>
        <obo:IAO_0000115>A device that has been constructed so as to emit subatomic particles.</obo:IAO_0000115>
        <rdfs:comment>Radiation source refers to the device that actually produces the radiation independent of the application to radiation therapy.  For example, a linear accelerator operating in the megavoltage regime produces a beam of x-rays by accelerating electrons and using them to create bremmstrahlung.  Such a device can be attached to some sort of flexible armature for positioning and outfitted with dose monitors and electronic feedback circuits, etc to make a radiation therapy device.  Other examples are manufactured Co-60 pellets, proton cyclotrons, etc.</rdfs:comment>
        <rdfs:label xml:lang="en">radiation device</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000003 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000968"/>
        <obo:IAO_0000115>A device that is used to position a patient during a health care process.</obo:IAO_0000115>
        <rdfs:comment>Such a device is  also often used to partially or completely immobilize the patient during the process.</rdfs:comment>
        <rdfs:label xml:lang="en">patient positioner</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000005 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000968"/>
        <obo:IAO_0000115>A device that is used to deliver radiation therapy to a patient.</obo:IAO_0000115>
        <rdfs:isDefinedBy>Mark Phillips</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">radiation therapy device</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000006 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000006">
        <rdfs:subClassOf rdf:resource="http://purl.archive.org/purl/rto-draft/RTO_0000005"/>
        <obo:IAO_0000115>A radiation therapy device in that generaties ionizing radiation outside of the body and the radiation passes from the source through space and parts of the body in order to irradiate the desired target tissue.</obo:IAO_0000115>
        <rdfs:isDefinedBy>Mark Phillips</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">external therapy device</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000007 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000007">
        <rdfs:subClassOf rdf:resource="http://purl.archive.org/purl/rto-draft/RTO_0000005"/>
        <obo:IAO_0000115>A radiation therapy device that relies on ionizing radiation generated within the body.</obo:IAO_0000115>
        <rdfs:isDefinedBy>Mark Phillips</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">brachytherapy device</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000008 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000008">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00002118"/>
        <obo:IAO_0000115>The radioactive decay process by which an atom&apos;s inner orbital electron is absorbed within the nucleus followed by conversion of a proton to a neutron and emission of a neutrino.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">electron capture</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000009 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00002118"/>
        <obo:IAO_0000115>A subatomic process in which a nucleus moves to a lower energy state by the emission of a photon.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">gamma emission</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000010 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000011"/>
        <obo:IAO_0000115>An atom that contains a specific number of neutrons and a specific atomic mass.</obo:IAO_0000115>
        <rdfs:comment>Elements are defined as atoms with a specific  number of protons in the nucleus.  The number of neutrons can vary, with each variation denoting a specific isotope of that element.</rdfs:comment>
        <rdfs:isDefinedBy>NCI</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">isotope</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000011 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000011">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000010"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/RBO_00002118"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.archive.org/purl/rto-draft/RTO_0000010"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/RBO_00002118"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An isotope that undergoes radioactive decay.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">radioactive isotope</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000013 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000013">
        <rdfs:subClassOf rdf:resource="http://purl.archive.org/purl/rto-draft/RTO_0000002"/>
        <obo:IAO_0000115>A radiation source that has a radioactive isotope as the source of subatomic particles.</obo:IAO_0000115>
        <rdfs:comment>Needs object property &quot;has part&quot; and then should be stated &quot;has part radioactive isotope&quot;.</rdfs:comment>
        <rdfs:label xml:lang="en">radioactive isotopic source</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000016 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RBO_00015006"/>
        <obo:IAO_0000115>The process by which a charged particle emits radiation due to its acceleration caused by an electric field.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">bremsstrahlung process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000019 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001018"/>
        <obo:IAO_0000115>A quality that is the distribution of energies of the constituent subatomic particles that constitute a radiation emission.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">spectrum</rdfs:label>
        <rdfs:seeAlso>http://purl.obolibrary.org/obo/CHMO_0000800.  A plot of a measured quantity against some experimental parameter.</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000020 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000027"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="http://purl.archive.org/purl/rto-draft/RTO_0000019"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An object aggregate  that that consists of a collection of subatomic particles that are moving in a given direction with a given energy spectrum.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">radiation beam</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000021 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000021">
        <rdfs:subClassOf rdf:resource="http://purl.archive.org/purl/rto-draft/RTO_0000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
                <owl:someValuesFrom rdf:resource="http://purl.archive.org/purl/rto-draft/RTO_0000016"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A radiotherapy device that is designed to produce ionizing radiation for therapeutic purposes and whose radiation source consists of a monoenergetic beam of electrons that are accelerated in a linear waveguide.</obo:IAO_0000115>
        <obo:IAO_0000118>&quot;linac&quot;, &quot;linear accelerator&quot;</obo:IAO_0000118>
        <rdfs:comment>Most medical linear accelerators have two modes: electron and photon. If the electrons are steered into a high Z target, bremsstrahlung will result in x-rays which can then be used to treat.</rdfs:comment>
        <rdfs:label xml:lang="en">medical linear accelerator</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000023 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000023">
        <rdfs:subClassOf rdf:resource="http://purl.archive.org/purl/rto-draft/RTO_0000011"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
                <owl:someValuesFrom rdf:resource="http://purl.archive.org/purl/rto-draft/RTO_0000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An isotope of iodine with A=125, Z=53</obo:IAO_0000115>
        <obo:IAO_0000118>I-125</obo:IAO_0000118>
        <rdfs:label xml:lang="en">Iodine-125</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000024 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000024">
        <rdfs:subClassOf rdf:resource="http://purl.archive.org/purl/rto-draft/RTO_0000011"/>
        <obo:IAO_0000115>An isotope of iridium with A=192, Z=77</obo:IAO_0000115>
        <obo:IAO_0000118>Ir-192</obo:IAO_0000118>
        <rdfs:label xml:lang="en">Iridium-192</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000025 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000025">
        <rdfs:subClassOf rdf:resource="http://purl.archive.org/purl/rto-draft/RTO_0000011"/>
        <obo:IAO_0000115>An isotope of cobalt with A=60, Z=27</obo:IAO_0000115>
        <obo:IAO_0000118>Co-60</obo:IAO_0000118>
        <rdfs:label xml:lang="en">Cobalt-60</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000026 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000026">
        <rdfs:subClassOf rdf:resource="http://purl.archive.org/purl/rto-draft/RTO_0000011"/>
        <obo:IAO_0000115>An isotope of cesium with A=137, Z=55</obo:IAO_0000115>
        <obo:IAO_0000118>Cs-137</obo:IAO_0000118>
        <rdfs:label xml:lang="en">Cesium-137</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000030 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
        <obo:IAO_0000115>A site that denotes a region of the body that contains disease that is to be irradiated during a radiation therapy procedure.</obo:IAO_0000115>
        <rdfs:comment>According to Arp et al, a site is relative to another body.  Examples given are the hold of a ship or the interior of a railcar.  They can move through space, as opposed to a spatial region which is immovable.  This seems appropriate for the region containing a tumor.</rdfs:comment>
        <rdfs:label xml:lang="en">target volume</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000031 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000031">
        <rdfs:subClassOf rdf:resource="http://purl.archive.org/purl/rto-draft/RTO_0000030"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.archive.org/purl/rto-draft/RTO_0000033"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A target volume that encompasses the tissue that contains the gross tumor volume plus tissue that is suspected to contain microscopic tumor.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">clinical target volume</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000032 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000032">
        <rdfs:subClassOf rdf:resource="http://purl.archive.org/purl/rto-draft/RTO_0000030"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.archive.org/purl/rto-draft/RTO_0000031"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A target volume that encompasses the tissue that contains macroscopic tumor or other tissue that is intended to be irradiated.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">gross tumor volume</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000033 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000033">
        <rdfs:subClassOf rdf:resource="http://purl.archive.org/purl/rto-draft/RTO_0000030"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.archive.org/purl/rto-draft/RTO_0000031"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A target volume that contains the gross tumor volume and clinical target volume (if it exists) and a margin to account for uncertainty in setting up the patient for irradiation.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">planning target volume</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000034 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000034">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000179"/>
        <obo:IAO_0000115>A histogram that displays the volume of a region of interest that receives a given dose during radiation therapy.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">dose volume histogram</rdfs:label>
        <rdfs:seeAlso>DVH</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000035 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000035">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000005"/>
        <obo:IAO_0000115>An objective specification that describes the dosimetric and fractionation objectives of a radiation therapy treatment.</obo:IAO_0000115>
        <rdfs:comment>Example: Total body irradiation to 13.2 Gy in 8 fractions of 1.65 Gy BID with lung blocks and no testicular boost.</rdfs:comment>
        <rdfs:label xml:lang="en">radiation therapy prescription</rdfs:label>
        <rdfs:seeAlso>A verbal or written order given by an authorized person instructing a patient to obtain and use a medical device, prescription or undergo a procedure. [Definition Source: NCI]
http://purl.obolibrary.org/obo/NCIT_C28180</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000036 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000036">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000007"/>
        <obo:IAO_0000115>An action specification that describes the method of irradiation in the domain of radiation therapy.</obo:IAO_0000115>
        <rdfs:comment>Example: 7 field IMRT with 6 MV photons.</rdfs:comment>
        <rdfs:comment>Examples: [3D conformal radiation with parallel opposed 18 MV x-rays], [en face 10 MeV electron field]</rdfs:comment>
        <rdfs:comment>This class can encompass what is sometimes called &quot;modality&quot; or &quot;technique&quot;, both of which are terms that are often inconsistent, incomplete and not common across the entire community.  However, it does need to be complete enough so that when coupled with a prescription, provides sufficient information to be concretized as a protocol and eventually realized as a process.</rdfs:comment>
        <rdfs:label xml:lang="en">radiation therapy method</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000037 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000037">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <obo:IAO_0000115>A plan specification that describes radiation therapy methods and prescriptions as applicable to certain patient classes.</obo:IAO_0000115>
        <rdfs:comment>Example: The elements of a clinical study that details the manner in which radiation therapy will be applied as part of that study.
Example: NRG-LU008 is a clinical study for people with non-small cell lung cancer (NSCLC) that has spread to the lymph nodes in the chest and is not able to be treated by surgery. The radiation therapy protocol of this research study details the use of SBRT.</rdfs:comment>
        <rdfs:comment>This class name uses the term &quot;protocol&quot; in a general sense that also includes research protocols and institution-specific therapy protocols.</rdfs:comment>
        <rdfs:label xml:lang="en">radiation therapy protocol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000038 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000038">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <obo:IAO_0000115>A plan specification that has parts radiation therapy method and radiation therapy prescription and provides details required for its realization in a plan and subsequent concretization in a radiation therapy treatment.</obo:IAO_0000115>
        <rdfs:comment>Following the discussion Arp et al, this class can be instantiated in multiple ways and is not meant to be restrictive to a particular mode, such as a printout or set of DICOM objects.</rdfs:comment>
        <rdfs:label xml:lang="en">radiation therapy plan specification</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000039 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000039">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000096"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0000260"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A healthcare process that uses ionizing radiation to treat a condition within the body as the realization of a plan that concretized a radiation therapy plan specification.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">radiation therapy treatment</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000040 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000040">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <obo:IAO_0000115>A set of values that of relevant machine parameters that represent the physical state of a radiation therapy device at a given  moment.  A temporally-ordered set of control points can be used to document changes in the state, e.g. movement of a gantry, change in monitor units.  The exact set of measurements  needed may depend on the radiation therapy device and the intended use of them.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">control_point</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000088 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000088">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000968"/>
        <obo:IAO_0000115>A device used in a radiation therapy process that modulates the dose deposited by a radiation beam in order to better conform the dose distribution to the target volume.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">compensator</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000089 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000089">
        <rdfs:subClassOf rdf:resource="http://purl.archive.org/purl/rto-draft/RTO_0000088"/>
        <obo:IAO_0000115>A compensator that modulates the dose distribution of a beam of x-rays by varying the fluence of x-rays across the beam profile.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">x-ray compensator</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000090 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000090">
        <rdfs:subClassOf rdf:resource="http://purl.archive.org/purl/rto-draft/RTO_0000088"/>
        <obo:IAO_0000115>A compensator that modulates the dose distribution of a beam of charged particles by varying the energy of the particles across the beam profile.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">charged particle compensator</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000091 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000091">
        <rdfs:subClassOf rdf:resource="http://purl.archive.org/purl/rto-draft/RTO_0000089"/>
        <obo:IAO_0000115>An x-ray compensator that modulates the x-ray fluence in one dimension across the beam profile.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">wedge</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000092 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000092">
        <rdfs:subClassOf rdf:resource="http://purl.archive.org/purl/rto-draft/RTO_0000001"/>
        <obo:IAO_0000115>A collimator that limits the extent of the irradiated field by means of multiple pieces of hardware whose positions in the radiation beam can be varied so as to achieve the desired beam profile.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">multileaf collimator</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000093 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000093">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000398"/>
        <obo:IAO_0000115>An image creation device in which a volume of tissue is simultaneously exposed to x-rays, captured by a 2-dimensional screen, and a series of tomographic image slices are computed.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">cone beam computed tomography scanner</rdfs:label>
        <rdfs:seeAlso>CBCT
Cone beam CT</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0000094 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0000094">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000398"/>
        <obo:IAO_0000115>An image creation device in which tomographic images are obtained through the use of radiofrequency waves, large homogeneous magnetic field and magnetic field gradients.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">magnetic resonance tomographic scanner</rdfs:label>
        <rdfs:seeAlso>MRI
MR scanner</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0001017 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0001017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000096"/>
        <obo:IAO_0000115>A health care process that uses drugs to stop the growth of cancer cells, either by killing the cells or by stopping them from dividing.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">oncologic chemotherapy</rdfs:label>
        <rdfs:seeAlso>National Cancer Institute:
https://www.cancer.gov/publications/dictionaries/cancer-terms/def/chemotherapy</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0001018 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0001018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000096"/>
        <obo:IAO_0000115>A health care process that surgically removes or samples cancerous tissue.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">oncologic surgery</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0001019 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0001019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000096"/>
        <obo:IAO_0000115>A health care process that stimulates the immune system to treat cancer, improving the immune system&apos;s natural ability to fight the disease.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">oncologic immunotherapy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0001020 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0001020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000096"/>
        <obo:IAO_0000115>A health care process that treats cancer by using drugs or other substances to target specific molecutles that cancer cells nned to survive and spread.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">oncologic targeted therapy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0001024 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0001024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000096"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.archive.org/purl/rto-draft/RTO_0000003"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002012"/>
                <owl:someValuesFrom rdf:resource="http://purl.archive.org/purl/rto-draft/RTO_0000039"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A health care process which prepares a patient for radiation therapy treatment by means of imaging, localization and may include the manufacture of localization devices.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">radiation therapy simulation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0001025 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0001025">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000096"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002012"/>
                <owl:someValuesFrom rdf:resource="http://purl.archive.org/purl/rto-draft/RTO_0000039"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A health care process that consists of a single episode (fraction) of the delivery of radiation therapy.</obo:IAO_0000115>
        <rdfs:comment>A radiation therapy treatment consists of 1 or more radiation therapy sessions.
Each session is bounded by the entrance to a treatment room until the prescribed treatment has been executed and the patient leaves the room.</rdfs:comment>
        <rdfs:label xml:lang="en">radiation therapy session</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0001026 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0001026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000096"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002012"/>
                <owl:someValuesFrom rdf:resource="http://purl.archive.org/purl/rto-draft/RTO_0000039"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A health care process that consists of localizing and positioning the patient by means of some imaging process in order to carry out the prescribed radiation therapy treatment.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">radiation therapy imaging</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0001027 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0001027">
        <rdfs:subClassOf rdf:resource="http://purl.archive.org/purl/rto-draft/RTO_0001026"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.archive.org/purl/rto-draft/RTO_0000093"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A radiation therapy imaging process that utilizes cone beam CT imaging in order to visualize the appropriate anatomy and matching that to the planning images.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">cone beam computed tomography</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.archive.org/purl/rto-draft/RTO_0001028 -->

    <owl:Class rdf:about="http://purl.archive.org/purl/rto-draft/RTO_0001028">
        <rdfs:subClassOf rdf:resource="http://purl.archive.org/purl/rto-draft/RTO_0001026"/>
        <obo:IAO_0000115>A radiation therapy imaging process that uses 2D planar images in order to localize the anatomy and match that with the planning images.</obo:IAO_0000115>
        <rdfs:comment>Typically a port film is carried out using megavoltage photons, but if the treatment device is so equipped, kilovoltage photons can be used.</rdfs:comment>
        <rdfs:label xml:lang="en">port film</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000001">
        <obo:BFO_0000179>entity</obo:BFO_0000179>
        <obo:BFO_0000180>Entity</obo:BFO_0000180>
        <obo:IAO_0000112 xml:lang="en">Julius Caesar</obo:IAO_0000112>
        <obo:IAO_0000112 xml:lang="en">Verdi’s Requiem</obo:IAO_0000112>
        <obo:IAO_0000112 xml:lang="en">the Second World War</obo:IAO_0000112>
        <obo:IAO_0000112 xml:lang="en">your body mass index</obo:IAO_0000112>
        <obo:IAO_0000116 xml:lang="en">BFO 2 Reference: In all areas of empirical inquiry we encounter general terms of two sorts. First are general terms which refer to universals or types:animaltuberculosissurgical procedurediseaseSecond, are general terms used to refer to groups of entities which instantiate a given universal but do not correspond to the extension of any subuniversal of that universal because there is nothing intrinsic to the entities in question by virtue of which they – and only they – are counted as belonging to the given group. Examples are: animal purchased by the Emperortuberculosis diagnosed on a Wednesdaysurgical procedure performed on a patient from Stockholmperson identified as candidate for clinical trial #2056-555person who is signatory of Form 656-PPVpainting by Leonardo da VinciSuch terms, which represent what are called ‘specializations’ in [81</obo:IAO_0000116>
        <obo:IAO_0000600 xml:lang="en">An entity is anything that exists or has existed or will exist. (axiom label in BFO2 Reference: [001-001])</obo:IAO_0000600>
        <rdfs:label xml:lang="en">entity</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000600"/>
        <owl:annotatedTarget xml:lang="en">An entity is anything that exists or has existed or will exist. (axiom label in BFO2 Reference: [001-001])</owl:annotatedTarget>
        <obo:IAO_0010000 rdf:resource="http://purl.obolibrary.org/obo/bfo/axiom/001-001"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <owl:disjointWith>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
            </owl:Restriction>
        </owl:disjointWith>
        <obo:BFO_0000179>continuant</obo:BFO_0000179>
        <obo:BFO_0000180>Continuant</obo:BFO_0000180>
        <obo:IAO_0000115 xml:lang="en">An entity that exists in full at any time in which it exists at all, persists through time while maintaining its identity and has no temporal parts.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">BFO 2 Reference: Continuant entities are entities which can be sliced to yield parts only along the spatial dimension, yielding for example the parts of your table which we call its legs, its top, its nails. ‘My desk stretches from the window to the door. It has spatial parts, and can be sliced (in space) in two. With respect to time, however, a thing is a continuant.’ [60, p. 240</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">Continuant doesn&apos;t have a closure axiom because the subclasses don&apos;t necessarily exhaust all possibilites. For example, in an expansion involving bringing in some of Ceuster&apos;s other portions of reality, questions are raised as to whether universals are continuants</obo:IAO_0000116>
        <obo:IAO_0000600 xml:lang="en">A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity. (axiom label in BFO2 Reference: [008-002])</obo:IAO_0000600>
        <obo:IAO_0000601 xml:lang="en">if b is a continuant and if, for some t, c has_continuant_part b at t, then c is a continuant. (axiom label in BFO2 Reference: [126-001])</obo:IAO_0000601>
        <obo:IAO_0000601 xml:lang="en">if b is a continuant and if, for some t, cis continuant_part of b at t, then c is a continuant. (axiom label in BFO2 Reference: [009-002])</obo:IAO_0000601>
        <obo:IAO_0000601 xml:lang="en">if b is a material entity, then there is some temporal interval (referred to below as a one-dimensional temporal region) during which b exists. (axiom label in BFO2 Reference: [011-002])</obo:IAO_0000601>
        <obo:IAO_0000602>(forall (x y) (if (and (Continuant x) (exists (t) (continuantPartOfAt y x t))) (Continuant y))) // axiom label in BFO2 CLIF: [009-002] </obo:IAO_0000602>
        <obo:IAO_0000602>(forall (x y) (if (and (Continuant x) (exists (t) (hasContinuantPartOfAt y x t))) (Continuant y))) // axiom label in BFO2 CLIF: [126-001] </obo:IAO_0000602>
        <obo:IAO_0000602>(forall (x) (if (Continuant x) (Entity x))) // axiom label in BFO2 CLIF: [008-002] </obo:IAO_0000602>
        <obo:IAO_0000602>(forall (x) (if (Material Entity x) (exists (t) (and (TemporalRegion t) (existsAt x t))))) // axiom label in BFO2 CLIF: [011-002] </obo:IAO_0000602>
        <rdfs:label>continuant</rdfs:label>
        <rdfs:label xml:lang="en">continuant</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000116"/>
        <owl:annotatedTarget xml:lang="en">Continuant doesn&apos;t have a closure axiom because the subclasses don&apos;t necessarily exhaust all possibilites. For example, in an expansion involving bringing in some of Ceuster&apos;s other portions of reality, questions are raised as to whether universals are continuants</owl:annotatedTarget>
        <obo:IAO_0010000 rdf:resource="http://purl.obolibrary.org/obo/bfo/axiom/0000007"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000600"/>
        <owl:annotatedTarget xml:lang="en">A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity. (axiom label in BFO2 Reference: [008-002])</owl:annotatedTarget>
        <obo:IAO_0010000 rdf:resource="http://purl.obolibrary.org/obo/bfo/axiom/008-002"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000601"/>
        <owl:annotatedTarget xml:lang="en">if b is a continuant and if, for some t, c has_continuant_part b at t, then c is a continuant. (axiom label in BFO2 Reference: [126-001])</owl:annotatedTarget>
        <obo:IAO_0010000 rdf:resource="http://purl.obolibrary.org/obo/bfo/axiom/126-001"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000601"/>
        <owl:annotatedTarget xml:lang="en">if b is a continuant and if, for some t, cis continuant_part of b at t, then c is a continuant. (axiom label in BFO2 Reference: [009-002])</owl:annotatedTarget>
        <obo:IAO_0010000 rdf:resource="http://purl.obolibrary.org/obo/bfo/axiom/009-002"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000601"/>
        <owl:annotatedTarget xml:lang="en">if b is a material entity, then there is some temporal interval (referred to below as a one-dimensional temporal region) during which b exists. (axiom label in BFO2 Reference: [011-002])</owl:annotatedTarget>
        <obo:IAO_0010000 rdf:resource="http://purl.obolibrary.org/obo/bfo/axiom/011-002"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000602"/>
        <owl:annotatedTarget>(forall (x y) (if (and (Continuant x) (exists (t) (continuantPartOfAt y x t))) (Continuant y))) // axiom label in BFO2 CLIF: [009-002] </owl:annotatedTarget>
        <obo:IAO_0010000 rdf:resource="http://purl.obolibrary.org/obo/bfo/axiom/009-002"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000602"/>
        <owl:annotatedTarget>(forall (x y) (if (and (Continuant x) (exists (t) (hasContinuantPartOfAt y x t))) (Continuant y))) // axiom label in BFO2 CLIF: [126-001] </owl:annotatedTarget>
        <obo:IAO_0010000 rdf:resource="http://purl.obolibrary.org/obo/bfo/axiom/126-001"/>
    </owl:Axiom>
    <owl:Axiom>
