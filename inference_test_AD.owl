    </owl:Class>
    


    <!-- http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#radiation_therapy_session -->

    <owl:Class rdf:about="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#radiation_therapy_session">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#planned_process"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#occurent_part_of"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#radiation_therapy_phase"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#has_participant"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#planning_target_volume"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#has_occurent_part"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#radiation_therapy_procedure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>From IHERO, the essential elements for a phase are these (note that their definition of a phase is a set of identical treatments which we define as a session):
label
start date
end date
modalities: session
techniques: session
number of delivered fractions
dose delivered to volumes: session
dose per fraction: session
total delivered dose from phase</rdfs:comment>
    </owl:Class>
    


