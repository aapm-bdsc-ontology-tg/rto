    <!-- http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#isPartOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#isPartOf"/>
    


    <!-- http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#occurent_part_of -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#occurent_part_of">
        <obo:IAO_0000115>&quot;p occurent_part_of q. This is a primitive relation of parthood, holding independently of time, between prcoess instances when one is a subprocess of the other.  For example, this tumor&apos;s growth occurent_part_of Mary&apos;s life.&quot;</obo:IAO_0000115>
    </owl:ObjectProperty>
    


