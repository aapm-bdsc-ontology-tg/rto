    <!-- http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#radiation_therapy_phase -->

    <owl:Class rdf:about="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#radiation_therapy_phase">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#planned_process"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#has_occurent_part"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#radiation_therapy_procedure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#occurent_part_of"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#radiation_therapy_course"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#radiation_therapy_procedure -->

