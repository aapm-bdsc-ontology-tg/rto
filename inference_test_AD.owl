    <!-- http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#IMRT:oroo -->

    <owl:Class rdf:about="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#IMRT:oroo">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#technique_action_specification"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#hasPart"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#inverse_planned_specification"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#hasPart"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#multileaf_collimator"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#hasPart"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">5</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#control_point"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#IMRT:oroo2 -->

    <owl:Class rdf:about="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#IMRT:oroo2">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#technique_action_specification"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#hasPart"/>
