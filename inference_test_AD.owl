    <!-- http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#hasPart -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#hasPart">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#isPartOf"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#has_occurent_part -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#has_occurent_part">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#occurent_part_of"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/markphillips/ontologies/2022/1/untitled-ontology-44#has_participant -->

