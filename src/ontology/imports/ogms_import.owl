#   Classes
############################

# Class: <http://purl.obolibrary.org/obo/BFO_0000015> (process)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000015> "process"@en)

# Class: <http://purl.obolibrary.org/obo/BFO_0000027> (object aggregate)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000027> "object aggregate"@en)
SubClassOf(<http://purl.obolibrary.org/obo/BFO_0000027> <http://purl.obolibrary.org/obo/BFO_0000040>)

# Class: <http://purl.obolibrary.org/obo/BFO_0000029> (site)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000029> "site"@en)

# Class: <http://purl.obolibrary.org/obo/BFO_0000030> (object)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000030> "object"@en)
SubClassOf(<http://purl.obolibrary.org/obo/BFO_0000030> <http://purl.obolibrary.org/obo/BFO_0000040>)

# Class: <http://purl.obolibrary.org/obo/BFO_0000040> (material entity)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000040> "material entity"@en)

# Class: <http://purl.obolibrary.org/obo/OBI_0000011> (planned process)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OBI_0000011> "A process that realizes a plan which is the concretization of a plan specification."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OBI_0000011> "planned process"@en)
SubClassOf(<http://purl.obolibrary.org/obo/OBI_0000011> <http://purl.obolibrary.org/obo/BFO_0000015>)

# Class: <http://purl.obolibrary.org/obo/OGMS_0000063> (disease course)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OGMS_0000063> "The totality of all processes through which a given disease instance is realized."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OGMS_0000063> "disease course")
SubClassOf(<http://purl.obolibrary.org/obo/OGMS_0000063> <http://purl.obolibrary.org/obo/BFO_0000015>)

# Class: <http://purl.obolibrary.org/obo/OGMS_0000090> (treatment)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OGMS_0000090> "A planned process whose completion is hypothesized by a health care provider to eliminate, prevent, or alleviate a disorder, the signs and symptoms of a disorder, or a pathological process"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OGMS_0000090> "treatment")
SubClassOf(<http://purl.obolibrary.org/obo/OGMS_0000090> <http://purl.obolibrary.org/obo/OGMS_0000096>)

# Class: <http://purl.obolibrary.org/obo/OGMS_0000096> (health care process)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OGMS_0000096> "A planned process with the objective to improve the health status of a patient that directly involves the treatment, diagnosis, or prevention of disease or injury of a patient"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OGMS_0000096> "health care process")
SubClassOf(<http://purl.obolibrary.org/obo/OGMS_0000096> <http://purl.obolibrary.org/obo/OBI_0000011>)

# Class: <http://purl.obolibrary.org/obo/OGMS_0000112> (therapeutic procedure)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OGMS_0000112> "A treatment whose completion is hypothesized by a health care provider to eliminate a disorder or to alleviate the signs and symptoms of a disorder or pathological process.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OGMS_0000112> "therapeutic procedure"@en)
SubClassOf(<http://purl.obolibrary.org/obo/OGMS_0000112> <http://purl.obolibrary.org/obo/OGMS_0000090>)

# Class: <http://purl.obolibrary.org/obo/OGMS_0000113> (chemotherapy procedure)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OGMS_0000113> "A therapeutic procedure that uses synthetic or naturally-occurring chemicals")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OGMS_0000113> "chemotherapy procedure"@en)
SubClassOf(<http://purl.obolibrary.org/obo/OGMS_0000113> <http://purl.obolibrary.org/obo/OGMS_0000112>)

# Class: <http://purl.obolibrary.org/obo/OGMS_0000114> (immunotherapy procedure)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OGMS_0000114> "A therapeutic procedure that uses immune system derived entities.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OGMS_0000114> "immunotherapy procedure"@en)
SubClassOf(<http://purl.obolibrary.org/obo/OGMS_0000114> <http://purl.obolibrary.org/obo/OGMS_0000112>)

# Class: <http://purl.obolibrary.org/obo/OGMS_0000116> (radiation therapy procedure)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OGMS_0000116> "A therapeutic procedure that uses radiation.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OGMS_0000116> "radiation therapy procedure"@en)
SubClassOf(<http://purl.obolibrary.org/obo/OGMS_0000116> <http://purl.obolibrary.org/obo/OGMS_0000112>)


