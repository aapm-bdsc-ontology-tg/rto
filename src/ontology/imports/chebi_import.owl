# Class: <http://purl.obolibrary.org/obo/CHEBI_10545> (electron)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CHEBI_10545> "Elementary particle not affected by the strong force having a spin 1/2, a negative elementary charge and a rest mass of 0.000548579903(13) u, or 0.51099906(15) MeV.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_10545> "electron")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_10545> <http://purl.obolibrary.org/obo/CHEBI_36342>)

# Class: <http://purl.obolibrary.org/obo/CHEBI_149675> (helium-3(1+))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CHEBI_149675> "An inorganic radical cation resulting from the loss of one electron from helium-3.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_149675> "helium-3(1+)")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_149675> <http://purl.obolibrary.org/obo/CHEBI_24431>)

# Class: <http://purl.obolibrary.org/obo/CHEBI_149691> (carbon-12(4+))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CHEBI_149691> "A monoatomic tetracation resulting from the loss of four electrons from carbon-12.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_149691> "carbon-12(4+)")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_149691> <http://purl.obolibrary.org/obo/CHEBI_24431>)

# Class: <http://purl.obolibrary.org/obo/CHEBI_149692> (oxygen-16(6+))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CHEBI_149692> "A monoatomic hexacation resulting from the loss of six electrons from oxygen-16.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_149692> "oxygen-16(6+)")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_149692> <http://purl.obolibrary.org/obo/CHEBI_24431>)

# Class: <http://purl.obolibrary.org/obo/CHEBI_24431> (chemical entity)

