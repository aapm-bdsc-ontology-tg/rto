SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_149675> <http://purl.obolibrary.org/obo/CHEBI_24431>)

# Class: <http://purl.obolibrary.org/obo/CHEBI_149691> (carbon-12(4+))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CHEBI_149691> "A monoatomic tetracation resulting from the loss of four electrons from carbon-12.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_149691> "carbon-12(4+)")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_149691> <http://purl.obolibrary.org/obo/CHEBI_24431>)

# Class: <http://purl.obolibrary.org/obo/CHEBI_149692> (oxygen-16(6+))

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CHEBI_149692> "A monoatomic hexacation resulting from the loss of six electrons from oxygen-16.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_149692> "oxygen-16(6+)")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_149692> <http://purl.obolibrary.org/obo/CHEBI_24431>)

# Class: <http://purl.obolibrary.org/obo/CHEBI_231614> (Nivolumab)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CHEBI_231614> "Nivolumab is a human monoclonal antibody for Programmed Death Receptor-1 (PD-1). It is a targeted immunotherapy treatment against metastatic cancer.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_231614> "Nivolumab")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_231614> <http://purl.obolibrary.org/obo/NCIT_C308>)

# Class: <http://purl.obolibrary.org/obo/CHEBI_231679> (ipilimumab)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CHEBI_231679> "Ipilimumab is a human cytotoxic T-lymphocyte antigen 4 (CTLA-4) blocking antibody used to treat metastatic or unresectable melanoma.(DrugBank)")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_231679> "ipilimumab")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_231679> <http://purl.obolibrary.org/obo/NCIT_C308>)

# Class: <http://purl.obolibrary.org/obo/CHEBI_75047> (B-Raf inhibitor)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CHEBI_75047> "A serine/threonine kinase inhibitor that specifically inhibits human mutant serine/threonine kinase (B-Raf)")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_75047> "B-Raf inhibitor")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_75047> <http://purl.obolibrary.org/obo/NCIT_C163758>)


# Class: <http://purl.obolibrary.org/obo/CHEBI_79091> (EC 2.7.11.24 (mitogen-activated protein kinase) inhibitor)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CHEBI_79091> "An EC 2.7.11.* (protein-serine/threonine kinase) inhibitor that interferes with the action of mitogen-activated protein kinase (EC 2.7.11.24).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_79091> "MEK inhibitor")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_79091> <http://purl.obolibrary.org/obo/NCIT_C163758>)


