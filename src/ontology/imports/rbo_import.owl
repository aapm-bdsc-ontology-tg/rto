Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<http://purl.obolibrary.org/obo/rto/imports/rbo_import.owl>
<http://purl.obolibrary.org/obo/rto/releases/2023-12-12/imports/rbo_import.owl>
Annotation(<http://purl.org/dc/elements/1.1/source> <http://purl.obolibrary.org/obo/rbo/releases/2023-09-05/rbo.owl>)
Annotation(owl:versionInfo "2023-12-12")

Declaration(Class(<http://purl.obolibrary.org/obo/BFO_0000015>))
Declaration(Class(<http://purl.obolibrary.org/obo/OBI_0000968>))
Declaration(Class(<http://purl.obolibrary.org/obo/RBO_00000115>))
Declaration(Class(<http://purl.obolibrary.org/obo/RBO_00002118>))
Declaration(Class(<http://purl.obolibrary.org/obo/RBO_00015006>))
