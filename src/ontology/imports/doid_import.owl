Prefix(:=<http://purl.obolibrary.org/obo/rto/imports/doid_import.owl#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<http://purl.obolibrary.org/obo/rto/imports/doid_import.owl>
<http://purl.obolibrary.org/obo/rto/releases/2026-06-30/imports/doid_import.owl>
Annotation(<http://purl.org/dc/elements/1.1/source> <http://purl.obolibrary.org/obo/doid/releases/2026-05-30/doid.owl>)
Annotation(owl:versionInfo "2026-06-30")

Declaration(Class(<http://purl.obolibrary.org/obo/DOID_10283>))
Declaration(Class(<http://purl.obolibrary.org/obo/DOID_162>))
Declaration(Class(<http://purl.obolibrary.org/obo/DOID_2526>))
Declaration(Class(<http://purl.obolibrary.org/obo/DOID_4>))
Declaration(AnnotationProperty(<http://purl.org/dc/elements/1.1/source>))


############################
#   Classes
############################

# Class: <http://purl.obolibrary.org/obo/DOID_10283> (prostate cancer)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/DOID_10283> "prostate cancer"@en)
SubClassOf(<http://purl.obolibrary.org/obo/DOID_10283> <http://purl.obolibrary.org/obo/DOID_162>)

# Class: <http://purl.obolibrary.org/obo/DOID_162> (cancer)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/DOID_162> "cancer"@en)
SubClassOf(<http://purl.obolibrary.org/obo/DOID_162> <http://purl.obolibrary.org/obo/DOID_4>)

# Class: <http://purl.obolibrary.org/obo/DOID_2526> (prostate adenocarcinoma)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/DOID_2526> "prostate adenocarcinoma"@en)
SubClassOf(<http://purl.obolibrary.org/obo/DOID_2526> <http://purl.obolibrary.org/obo/DOID_10283>)

# Class: <http://purl.obolibrary.org/obo/DOID_4> (disease)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/DOID_4> "disease"@en)


