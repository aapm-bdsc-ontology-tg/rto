AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000101> "Amersham 6702"@en)
ClassAssertion(<http://purl.archive.org/purl/rto-draft/RTO_0000013> <http://purl.archive.org/purl/rto-draft/RTO_0000101>)
ObjectPropertyAssertion(<http://purl.obolibrary.org/obo/rto.owl/RTO_0000010> <http://purl.archive.org/purl/rto-draft/RTO_0000101> <http://purl.archive.org/purl/rto-draft/RTO_0000102>)

# Individual: <http://purl.archive.org/purl/rto-draft/RTO_0000102> (Iodine-125)

AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000102> "Iodine-125"@en)
ClassAssertion(<http://purl.archive.org/purl/rto-draft/RTO_0000011> <http://purl.archive.org/purl/rto-draft/RTO_0000102>)
ClassAssertion(ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000056> <http://purl.archive.org/purl/rto-draft/RTO_0000008>) <http://purl.archive.org/purl/rto-draft/RTO_0000102>)


DifferentIndividuals(<http://purl.archive.org/purl/rto-draft/RTO_0000101> <http://purl.archive.org/purl/rto-draft/RTO_0000102>)
