Prefix(:=<http://purl.obolibrary.org/obo/rto.owl#>)
Prefix(dce:=<http://purl.org/dc/elements/1.1/>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(dcterms:=<http://purl.org/dc/terms/>)


Ontology(<http://purl.obolibrary.org/obo/rto.owl>
Import(<http://purl.obolibrary.org/obo/rto/imports/bfo_import.owl>)
Import(<http://purl.obolibrary.org/obo/rto/imports/chebi_import.owl>)
Import(<http://purl.obolibrary.org/obo/rto/imports/cob_import.owl>)
Import(<http://purl.obolibrary.org/obo/rto/imports/iao_import.owl>)
Import(<http://purl.obolibrary.org/obo/rto/imports/obi_import.owl>)
Import(<http://purl.obolibrary.org/obo/rto/imports/ogms_import.owl>)
Import(<http://purl.obolibrary.org/obo/rto/imports/pato_import.owl>)
Import(<http://purl.obolibrary.org/obo/rto/imports/ro_import.owl>)
Annotation(dcterms:description "None")
Annotation(dcterms:license <https://creativecommons.org/licenses/unspecified>)
Annotation(dcterms:title "Radiation Therapy Ontology")

Declaration(Class(<http://purl.archive.org/purl/rto-draft/RTO_0000004>))
Declaration(Class(<http://purl.archive.org/purl/rto-draft/RTO_0000005>))
Declaration(Class(<http://purl.archive.org/purl/rto-draft/RTO_0000006>))
Declaration(Class(<https://purl.archive.org/purl/rto-draft/RTO_0000001>))
Declaration(Class(<https://purl.archive.org/purl/rto-draft/RTO_0000002>))
Declaration(Class(<https://purl.archive.org/purl/rto-draft/RTO_0000003>))
Declaration(AnnotationProperty(dcterms:description))
Declaration(AnnotationProperty(dcterms:license))
Declaration(AnnotationProperty(dcterms:title))
############################
#   Annotation Properties
############################

# Annotation Property: dcterms:description (description)

AnnotationAssertion(rdfs:label dcterms:description "description")

# Annotation Property: dcterms:license (license)

AnnotationAssertion(rdfs:label dcterms:license "license")

# Annotation Property: dcterms:title (title)

AnnotationAssertion(rdfs:label dcterms:title "title")



############################
#   Classes
############################

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000004> (RT prescription)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000004> "An objective specification that details the desired dose, fractionation schedule and  modality that are the objectives of a particular course of radiation therapy.")
AnnotationAssertion(rdfs:comment <http://purl.archive.org/purl/rto-draft/RTO_0000004> "In normal medical practice, the RT prescription is a precursor to the development of an RT plan.")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000004> "RT prescription"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000004> <http://purl.obolibrary.org/obo/IAO_0000005>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000005> (RT modality)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000005> "An action specification that details the manner in which a radiation therapy treatment will be carried out.")
AnnotationAssertion(rdfs:comment <http://purl.archive.org/purl/rto-draft/RTO_0000005> "The \"manner in which it will be carried out\" implies a description of the type of radiation source, the pattern of irradiation, and type of device to deliver the pattern of irradiation.

Example: \"external beam radiation therapy using 6 MV photons delivered by a linac in a four field, opposed manner.\"

Example: \"Fixed field IMRT using 10 MV photons delivered by a linac using 7 non-opposed beams.\"

Example: \"Intracavitary brachytherapy using Ir-192 delivered by an HDR device with a vaginal cylinder.\"")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000005> "RT modality"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000005> <http://purl.obolibrary.org/obo/IAO_0000007>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000006> (RT plan)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000006> "A plan specification that includes an action specification and an objective specification for the delivery of a radiation therapy treatment.")
AnnotationAssertion(rdfs:comment <http://purl.archive.org/purl/rto-draft/RTO_0000006> "In accordance with the guidance in the book \"Building Ontologies with Basic Formal Ontology\" (Arp, Smith, Spear; 2015), the RT plan can be concretized by numerous methods, such as a DICOM files, a printed plan, and/or within the consciousness of the medical professionals involved in developing the plan.

An RT plan can be realized by means of a health care process.")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000006> "RT plan"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000006> <http://purl.obolibrary.org/obo/IAO_0000104>)

# Class: <https://purl.archive.org/purl/rto-draft/RTO_0000001> (collimator)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://purl.archive.org/purl/rto-draft/RTO_0000001> "A device that limits the 2D spatial extent of the fluence of subatomic particles.")
AnnotationAssertion(rdfs:label <https://purl.archive.org/purl/rto-draft/RTO_0000001> "collimator"@en)
SubClassOf(<https://purl.archive.org/purl/rto-draft/RTO_0000001> <http://purl.obolibrary.org/obo/COB_0001300>)

# Class: <https://purl.archive.org/purl/rto-draft/RTO_0000002> (radiation source)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://purl.archive.org/purl/rto-draft/RTO_0000002> "A device that has been constructed so as to emit subatomic particles.")
AnnotationAssertion(rdfs:comment <https://purl.archive.org/purl/rto-draft/RTO_0000002> "Radiation source refers to the device that actually produces the radiation independent of the application to radiation therapy.  For example, a linear accelerator operating in the megavoltage regime produces a beam of x-rays by accelerating electrons and using them to create bremmstrahlung.  Such a device can be attached to some sort of flexible armature for positioning and outfitted with dose monitors and electronic feedback circuits, etc to make a radiation therapy device.  Other examples are manufactured Co-60 pellets, proton cyclotrons, etc.")
AnnotationAssertion(rdfs:label <https://purl.archive.org/purl/rto-draft/RTO_0000002> "radiation source"@en)
SubClassOf(<https://purl.archive.org/purl/rto-draft/RTO_0000002> <http://purl.obolibrary.org/obo/COB_0001300>)

# Class: <https://purl.archive.org/purl/rto-draft/RTO_0000003> (patient positioner)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://purl.archive.org/purl/rto-draft/RTO_0000003> "A device that is used to position a patient during a health care process.")
AnnotationAssertion(rdfs:comment <https://purl.archive.org/purl/rto-draft/RTO_0000003> "Such a device is  also often used to partially or completely immobilize the patient during the process.")
AnnotationAssertion(rdfs:label <https://purl.archive.org/purl/rto-draft/RTO_0000003> "patient positioner"@en)
SubClassOf(<https://purl.archive.org/purl/rto-draft/RTO_0000003> <http://purl.obolibrary.org/obo/COB_0001300>)


)