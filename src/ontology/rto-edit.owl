############################
#   Annotation Properties
############################

# Annotation Property: dcterms:description (description)

AnnotationAssertion(rdfs:label dcterms:description "description")

# Annotation Property: dcterms:license (license)

AnnotationAssertion(rdfs:label dcterms:license "license")

# Annotation Property: dcterms:title (title)

AnnotationAssertion(rdfs:label dcterms:title "title")


############################
#   Object Properties
############################

# Object Property: <http://purl.archive.org/purl/rto-draft/RTO_0001046> (occurred at time)

AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0001046> "occurred at time"@en)
ObjectPropertyDomain(<http://purl.archive.org/purl/rto-draft/RTO_0001046> <http://purl.obolibrary.org/obo/BFO_0000015>)
ObjectPropertyRange(<http://purl.archive.org/purl/rto-draft/RTO_0001046> <http://purl.obolibrary.org/obo/IAO_0000582>)


############################
#   Data Properties
############################

# Data Property: <http://purl.archive.org/purl/rto-draft/RTO_0001008> (has specified timestamp value)

AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0001008> "has specified timestamp value"@en)
SubDataPropertyOf(<http://purl.archive.org/purl/rto-draft/RTO_0001008> <http://purl.obolibrary.org/obo/OBI_0002135>)
DataPropertyDomain(<http://purl.archive.org/purl/rto-draft/RTO_0001008> <http://purl.obolibrary.org/obo/IAO_0000582>)
DataPropertyRange(<http://purl.archive.org/purl/rto-draft/RTO_0001008> xsd:dateTime)

# Data Property: <http://purl.obolibrary.org/obo/OBI_0001937> (has specified numeric value)

DataPropertyDomain(<http://purl.obolibrary.org/obo/OBI_0001937> <http://purl.obolibrary.org/obo/IAO_0000109>)
DataPropertyRange(<http://purl.obolibrary.org/obo/OBI_0001937> xsd:float)



############################
#   Classes
############################

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000001> (collimator)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000001> "A device that limits the 2D spatial extent of the fluence of subatomic particles.")
AnnotationAssertion(rdfs:isDefinedBy <http://purl.archive.org/purl/rto-draft/RTO_0000001> "Mark Phillips")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000001> "collimator"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000001> <http://purl.obolibrary.org/obo/OBI_0000968>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000002> (radiation device)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000002> "A device that has been constructed so as to emit subatomic particles.")
AnnotationAssertion(rdfs:comment <http://purl.archive.org/purl/rto-draft/RTO_0000002> "Radiation source refers to the device that actually produces the radiation independent of the application to radiation therapy.  For example, a linear accelerator operating in the megavoltage regime produces a beam of x-rays by accelerating electrons and using them to create bremmstrahlung.  Such a device can be attached to some sort of flexible armature for positioning and outfitted with dose monitors and electronic feedback circuits, etc to make a radiation therapy device.  Other examples are manufactured Co-60 pellets, proton cyclotrons, etc.")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000002> "radiation device"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000002> <http://purl.obolibrary.org/obo/OBI_0000968>)
