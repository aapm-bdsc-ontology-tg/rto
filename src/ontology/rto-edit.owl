Prefix(:=<http://purl.obolibrary.org/obo/rto.owl#>)
Prefix(dce:=<http://purl.org/dc/elements/1.1/>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(dcterms:=<http://purl.org/dc/terms/>)


Ontology(<http://purl.obolibrary.org/obo/rto.owl>
Import(<http://purl.obolibrary.org/obo/rto/imports/bfo_import.owl>)
Import(<http://purl.obolibrary.org/obo/rto/imports/iao_import.owl>)
Import(<http://purl.obolibrary.org/obo/rto/imports/obi_import.owl>)
Import(<http://purl.obolibrary.org/obo/rto/imports/ogms_import.owl>)
Import(<http://purl.obolibrary.org/obo/rto/imports/ro_import.owl>)
Annotation(dcterms:description "None")
Annotation(dcterms:license <https://creativecommons.org/licenses/unspecified>)
Annotation(dcterms:title "Radiation Therapy Ontology")

Declaration(Class(<http://purl.obolibrary.org/obo/NCIT_C14225/human>))
Declaration(Class(<http://purl.obolibrary.org/obo/PATO_0000011/age>))
Declaration(Class(<http://purl.obolibrary.org/obo/PATO_0000383/female>))
Declaration(Class(<http://purl.obolibrary.org/obo/PATO_0000384/male>))
Declaration(AnnotationProperty(dcterms:description))
Declaration(AnnotationProperty(dcterms:license))
Declaration(AnnotationProperty(dcterms:title))
############################
#   Annotation Properties
############################

# Annotation Property: dcterms:description (description)

AnnotationAssertion(rdfs:label dcterms:description "description")

# Annotation Property: dcterms:license (license)

AnnotationAssertion(rdfs:label dcterms:license "license")

# Annotation Property: dcterms:title (title)

AnnotationAssertion(rdfs:label dcterms:title "title")



############################
#   Classes
############################

# Class: <http://purl.obolibrary.org/obo/IAO_0000030> (information content entity)

SubClassOf(<http://purl.obolibrary.org/obo/IAO_0000030> <http://purl.obolibrary.org/obo/BFO_0000031>)

# Class: <http://purl.obolibrary.org/obo/NCIT_C14225/human> (human)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/NCIT_C14225/human> "The bipedal primate mammal, Homo sapiens; belonging to man or mankind; pertaining to man or to the race of man; use of man as experimental subject or unit of analysis in research.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/NCIT_C14225/human> "The bipedal primate mammal, Homo sapiens; belonging to man or mankind; pertaining to man or to the race of man; use of man as experimental subject or unit of analysis in research.")
AnnotationAssertion(rdfs:isDefinedBy <http://purl.obolibrary.org/obo/NCIT_C14225/human> "National Cancer Institute")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/NCIT_C14225/human> "human")
AnnotationAssertion(rdfs:seeAlso <http://purl.obolibrary.org/obo/NCIT_C14225/human> "Homo sapiens")
SubClassOf(<http://purl.obolibrary.org/obo/NCIT_C14225/human> <http://purl.obolibrary.org/obo/BFO_0000040>)

# Class: <http://purl.obolibrary.org/obo/PATO_0000011/age> (age)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0000011/age> "A time quality inhering in a bearer by virtue of how long the bearer has existed.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PATO_0000011/age> "A time quality inhering in a bearer by virtue of how long the bearer has existed.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0000011/age> "age")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0000011/age> <http://purl.obolibrary.org/obo/BFO_0000019>)

# Class: <http://purl.obolibrary.org/obo/PATO_0000383/female> (female)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0000383/female> "A biological sex quality inhering in an individual or a population that only produces gametes that can be fertilised by male gametes.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PATO_0000383/female> "A biological sex quality inhering in an individual or a population that only produces gametes that can be fertilised by male gametes.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0000383/female> "female")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0000383/female> <http://purl.obolibrary.org/obo/BFO_0000019>)
DisjointClasses(<http://purl.obolibrary.org/obo/PATO_0000383/female> <http://purl.obolibrary.org/obo/PATO_0000384/male>)

# Class: <http://purl.obolibrary.org/obo/PATO_0000384/male> (male)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0000384/male> "A biological sex quality inhering in an individual or a population whose sex organs contain only male gametes.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PATO_0000384/male> "A biological sex quality inhering in an individual or a population whose sex organs contain only male gametes.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0000384/male> "male")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0000384/male> <http://purl.obolibrary.org/obo/BFO_0000019>)


)