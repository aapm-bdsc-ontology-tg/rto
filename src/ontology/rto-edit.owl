Declaration(ObjectProperty(<http://purl.obolibrary.org/obo/rto.owl/RTO_0000011>))
Declaration(NamedIndividual(<http://purl.archive.org/purl/rto-draft/RTO_0000101>))
Declaration(NamedIndividual(<http://purl.archive.org/purl/rto-draft/RTO_0000102>))
