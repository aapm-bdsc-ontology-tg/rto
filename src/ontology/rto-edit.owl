############################
#   Annotation Properties
############################

# Annotation Property: dcterms:description (description)

AnnotationAssertion(rdfs:label dcterms:description "description")

# Annotation Property: dcterms:license (license)

AnnotationAssertion(rdfs:label dcterms:license "license")

# Annotation Property: dcterms:title (title)

AnnotationAssertion(rdfs:label dcterms:title "title")


############################
#   Object Properties
############################

# Object Property: <http://purl.obolibrary.org/obo/rto.owl/RTO_0000010> (has part)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/rto.owl/RTO_0000010> "has part"@en)
InverseObjectProperties(<http://purl.obolibrary.org/obo/rto.owl/RTO_0000010> <http://purl.obolibrary.org/obo/rto.owl/RTO_0000011>)
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/rto.owl/RTO_0000010> <http://purl.obolibrary.org/obo/BFO_0000004>)
ObjectPropertyRange(<http://purl.obolibrary.org/obo/rto.owl/RTO_0000010> <http://purl.obolibrary.org/obo/BFO_0000004>)

# Object Property: <http://purl.obolibrary.org/obo/rto.owl/RTO_0000011> (is part of)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/rto.owl/RTO_0000011> "is part of"@en)
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/rto.owl/RTO_0000011> <http://purl.obolibrary.org/obo/BFO_0000004>)
ObjectPropertyRange(<http://purl.obolibrary.org/obo/rto.owl/RTO_0000011> <http://purl.obolibrary.org/obo/BFO_0000004>)



############################
#   Classes
############################

# Class: <http://purl.archive.org/purl/RTO_0000016> (bremsstrahlung process)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/RTO_0000016> "The process by which a charged particle emits radiation due to its acceleration caused by an electric field.")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/RTO_0000016> "bremsstrahlung process"@en)
SubClassOf(<http://purl.archive.org/purl/RTO_0000016> <http://purl.obolibrary.org/obo/RBO_00015006>)

# Class: <http://purl.archive.org/purl/RTO_0000018> (radiation emission)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/RTO_0000018> "An object aggregate that consists of a collection of subatomic particles emitted from the same radiation source.")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/RTO_0000018> "radiation emission"@en)
SubClassOf(<http://purl.archive.org/purl/RTO_0000018> <http://purl.obolibrary.org/obo/BFO_0000027>)

# Class: <http://purl.archive.org/purl/RTO_0000019> (spectrum)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/RTO_0000019> "A quality that is the distribution of energies of the constituent subatomic particles that constitute a radiation emission.")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/RTO_0000019> "spectrum"@en)
AnnotationAssertion(rdfs:seeAlso <http://purl.archive.org/purl/RTO_0000019> "http://purl.obolibrary.org/obo/CHMO_0000800.  A plot of a measured quantity against some experimental parameter.")
SubClassOf(<http://purl.archive.org/purl/RTO_0000019> <http://purl.obolibrary.org/obo/PATO_0001018>)

# Class: <http://purl.archive.org/purl/RTO_0000020> (radiation beam)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/RTO_0000020> "A radiation emission that has been produced or modified so that its consituent elements are moving in a given direction with a given energy spectrum.")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/RTO_0000020> "radiation beam"@en)
SubClassOf(<http://purl.archive.org/purl/RTO_0000020> <http://purl.archive.org/purl/RTO_0000018>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000005> (radiation therapy device)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000005> "A device that is used to deliver radiation therapy to a patient.")
AnnotationAssertion(rdfs:isDefinedBy <http://purl.archive.org/purl/rto-draft/RTO_0000005> "Mark Phillips")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000005> "radiation therapy device"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000005> <http://purl.obolibrary.org/obo/OBI_0000968>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000006> (external therapy device)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000006> "A radiation therapy device in that generaties ionizing radiation outside of the body and the radiation passes from the source through space and parts of the body in order to irradiate the desired target tissue.")
AnnotationAssertion(rdfs:isDefinedBy <http://purl.archive.org/purl/rto-draft/RTO_0000006> "Mark Phillips")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000006> "external therapy device"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000006> <http://purl.archive.org/purl/rto-draft/RTO_0000005>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000007> (brachytherapy device)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000007> "A radiation therapy device that relies on ionizing radiation generated within the body.")
AnnotationAssertion(rdfs:isDefinedBy <http://purl.archive.org/purl/rto-draft/RTO_0000007> "Mark Phillips")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000007> "brachytherapy device"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000007> <http://purl.archive.org/purl/rto-draft/RTO_0000005>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000008> (electron capture)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000008> "The radioactive decay process by which an atom's inner orbital electron is absorbed within the nucleus followed by conversion of a proton to a neutron and emission of a neutrino.")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000008> "electron capture"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000008> <http://purl.obolibrary.org/obo/RBO_00002118>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000009> (gamma emission)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000009> "A subatomic process in which a nucleus moves to a lower energy state by the emission of a photon.")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000009> "gamma emission"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000009> <http://purl.obolibrary.org/obo/RBO_00015006>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000010> (isotope)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000010> "A form of a chemical element containing a specific number of neutrons and a specific atomic mass.")
AnnotationAssertion(rdfs:isDefinedBy <http://purl.archive.org/purl/rto-draft/RTO_0000010> "NCI")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000010> "isotope"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000010> <http://purl.obolibrary.org/COB_0000011>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000011> (radioactive isotope)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000011> "An isotope that undergoes radioactive decay.")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000011> "radioactive isotope"@en)
EquivalentClasses(<http://purl.archive.org/purl/rto-draft/RTO_0000011> ObjectIntersectionOf(<http://purl.archive.org/purl/rto-draft/RTO_0000010> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000056> <http://purl.obolibrary.org/obo/RBO_00002118>)))

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000013> (radioactive isotopic source)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000013> "A radiation source that has a radioactive isotope as the source of subatomic particles.")
AnnotationAssertion(rdfs:comment <http://purl.archive.org/purl/rto-draft/RTO_0000013> "Needs object property \"has part\" and then should be stated \"has part radioactive isotope\".")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000013> "radioactive isotopic source"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000013> <https://purl.archive.org/purl/rto-draft/RTO_0000002>)

# Class: <http://purl.obolibrary.org/COB_0000011> (atom)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/COB_0000011> "A material entity consisting of exactly one atomic nucleus and the electron(s) orbiting it.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/COB_0000011> "atom")
SubClassOf(<http://purl.obolibrary.org/COB_0000011> <http://purl.obolibrary.org/obo/BFO_0000040>)

# Class: <http://purl.obolibrary.org/obo/http://purl.archive.org/purl/rto-draft/RTO_0000014> (RT method)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/http://purl.archive.org/purl/rto-draft/RTO_0000014> "A plan specification that describes how radiation therapy will be delivered by means of radiation sources.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/http://purl.archive.org/purl/rto-draft/RTO_0000014> "RT method"@en)
SubClassOf(<http://purl.obolibrary.org/obo/http://purl.archive.org/purl/rto-draft/RTO_0000014> <http://purl.obolibrary.org/obo/IAO_0000104>)

# Class: <http://purl.obolibrary.org/obo/http://purl.archive.org/purl/rto-draft/RTO_0000015> (brachytherapy)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/http://purl.archive.org/purl/rto-draft/RTO_0000015> "An RT method that describes the use of radiation source(s) within the region of the body to which it is intended to deliver radiation therapy.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/http://purl.archive.org/purl/rto-draft/RTO_0000015> "brachytherapy"@en)
SubClassOf(<http://purl.obolibrary.org/obo/http://purl.archive.org/purl/rto-draft/RTO_0000015> <http://purl.obolibrary.org/obo/http://purl.archive.org/purl/rto-draft/RTO_0000014>)

# Class: <http://purl.obolibrary.org/obo/http://purl.archive.org/purl/rto-draft/RTO_0000016> (external beam therapy)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/http://purl.archive.org/purl/rto-draft/RTO_0000016> "An RT method that describes the use of radiation sources external to the body to deliver radiation therapy.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/http://purl.archive.org/purl/rto-draft/RTO_0000016> "external beam therapy"@en)
SubClassOf(<http://purl.obolibrary.org/obo/http://purl.archive.org/purl/rto-draft/RTO_0000016> <http://purl.obolibrary.org/obo/http://purl.archive.org/purl/rto-draft/RTO_0000014>)

# Class: <https://purl.archive.org/purl/rto-draft/RTO_0000001> (collimator)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://purl.archive.org/purl/rto-draft/RTO_0000001> "A device that limits the 2D spatial extent of the fluence of subatomic particles.")
AnnotationAssertion(rdfs:isDefinedBy <https://purl.archive.org/purl/rto-draft/RTO_0000001> "Mark Phillips")
AnnotationAssertion(rdfs:label <https://purl.archive.org/purl/rto-draft/RTO_0000001> "collimator"@en)
SubClassOf(<https://purl.archive.org/purl/rto-draft/RTO_0000001> <http://purl.obolibrary.org/obo/OBI_0000968>)

# Class: <https://purl.archive.org/purl/rto-draft/RTO_0000002> (radiation source)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://purl.archive.org/purl/rto-draft/RTO_0000002> "A device that has been constructed so as to emit subatomic particles.")
AnnotationAssertion(rdfs:comment <https://purl.archive.org/purl/rto-draft/RTO_0000002> "Radiation source refers to the device that actually produces the radiation independent of the application to radiation therapy.  For example, a linear accelerator operating in the megavoltage regime produces a beam of x-rays by accelerating electrons and using them to create bremmstrahlung.  Such a device can be attached to some sort of flexible armature for positioning and outfitted with dose monitors and electronic feedback circuits, etc to make a radiation therapy device.  Other examples are manufactured Co-60 pellets, proton cyclotrons, etc.")
AnnotationAssertion(rdfs:label <https://purl.archive.org/purl/rto-draft/RTO_0000002> "radiation source"@en)
SubClassOf(<https://purl.archive.org/purl/rto-draft/RTO_0000002> <http://purl.obolibrary.org/obo/OBI_0000968>)

# Class: <https://purl.archive.org/purl/rto-draft/RTO_0000003> (patient positioner)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://purl.archive.org/purl/rto-draft/RTO_0000003> "A device that is used to position a patient during a health care process.")
AnnotationAssertion(rdfs:comment <https://purl.archive.org/purl/rto-draft/RTO_0000003> "Such a device is  also often used to partially or completely immobilize the patient during the process.")
AnnotationAssertion(rdfs:label <https://purl.archive.org/purl/rto-draft/RTO_0000003> "patient positioner"@en)
SubClassOf(<https://purl.archive.org/purl/rto-draft/RTO_0000003> <http://purl.obolibrary.org/obo/OBI_0000968>)


