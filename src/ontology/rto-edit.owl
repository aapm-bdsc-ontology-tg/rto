############################
#   Classes
############################

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000001> (collimator)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000001> "A device that limits the 2D spatial extent of the fluence of subatomic particles.")
AnnotationAssertion(rdfs:isDefinedBy <http://purl.archive.org/purl/rto-draft/RTO_0000001> "Mark Phillips")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000001> "collimator"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000001> <http://purl.obolibrary.org/obo/OBI_0000968>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000002> (radiation device)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000002> "A device that has been constructed so as to emit subatomic particles.")
AnnotationAssertion(rdfs:comment <http://purl.archive.org/purl/rto-draft/RTO_0000002> "Radiation source refers to the device that actually produces the radiation independent of the application to radiation therapy.  For example, a linear accelerator operating in the megavoltage regime produces a beam of x-rays by accelerating electrons and using them to create bremmstrahlung.  Such a device can be attached to some sort of flexible armature for positioning and outfitted with dose monitors and electronic feedback circuits, etc to make a radiation therapy device.  Other examples are manufactured Co-60 pellets, proton cyclotrons, etc.")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000002> "radiation device"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000002> <http://purl.obolibrary.org/obo/OBI_0000968>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000003> (patient positioner)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000003> "A device that is used to position a patient during a health care process.")
AnnotationAssertion(rdfs:comment <http://purl.archive.org/purl/rto-draft/RTO_0000003> "Such a device is  also often used to partially or completely immobilize the patient during the process.")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000003> "patient positioner"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000003> <http://purl.obolibrary.org/obo/OBI_0000968>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000005> (radiation therapy device)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000005> "A device that is used to deliver radiation therapy to a patient.")
AnnotationAssertion(rdfs:isDefinedBy <http://purl.archive.org/purl/rto-draft/RTO_0000005> "Mark Phillips")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000005> "radiation therapy device"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000005> <http://purl.obolibrary.org/obo/OBI_0000968>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000006> (external therapy device)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000006> "A radiation therapy device in that generaties ionizing radiation outside of the body and the radiation passes from the source through space and parts of the body in order to irradiate the desired target tissue.")
AnnotationAssertion(rdfs:isDefinedBy <http://purl.archive.org/purl/rto-draft/RTO_0000006> "Mark Phillips")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000006> "external therapy device"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000006> <http://purl.archive.org/purl/rto-draft/RTO_0000005>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000007> (brachytherapy device)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000007> "A radiation therapy device that relies on ionizing radiation generated within the body.")
AnnotationAssertion(rdfs:isDefinedBy <http://purl.archive.org/purl/rto-draft/RTO_0000007> "Mark Phillips")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000007> "brachytherapy device"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000007> <http://purl.archive.org/purl/rto-draft/RTO_0000005>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000008> (electron capture)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000008> "The radioactive decay process by which an atom's inner orbital electron is absorbed within the nucleus followed by conversion of a proton to a neutron and emission of a neutrino.")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000008> "electron capture"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000008> <http://purl.obolibrary.org/obo/RBO_00002118>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000009> (gamma emission)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000009> "A subatomic process in which a nucleus moves to a lower energy state by the emission of a photon.")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000009> "gamma emission"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000009> <http://purl.obolibrary.org/obo/RBO_00002118>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000010> (isotope)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000010> "An atom that contains a specific number of neutrons and a specific atomic mass.")
AnnotationAssertion(rdfs:comment <http://purl.archive.org/purl/rto-draft/RTO_0000010> "Elements are defined as atoms with a specific  number of protons in the nucleus.  The number of neutrons can vary, with each variation denoting a specific isotope of that element.")
AnnotationAssertion(rdfs:isDefinedBy <http://purl.archive.org/purl/rto-draft/RTO_0000010> "NCI")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000010> "isotope"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000010> <http://purl.obolibrary.org/obo/COB_0000011>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000011> (radioactive isotope)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000011> "An isotope that undergoes radioactive decay.")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000011> "radioactive isotope"@en)
EquivalentClasses(<http://purl.archive.org/purl/rto-draft/RTO_0000011> ObjectIntersectionOf(<http://purl.archive.org/purl/rto-draft/RTO_0000010> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000056> <http://purl.obolibrary.org/obo/RBO_00002118>)))

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000013> (radioactive isotopic source)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000013> "A radiation source that has a radioactive isotope as the source of subatomic particles.")
AnnotationAssertion(rdfs:comment <http://purl.archive.org/purl/rto-draft/RTO_0000013> "Needs object property \"has part\" and then should be stated \"has part radioactive isotope\".")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000013> "radioactive isotopic source"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000013> <http://purl.archive.org/purl/rto-draft/RTO_0000002>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000016> (bremsstrahlung process)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000016> "The process by which a charged particle emits radiation due to its acceleration caused by an electric field.")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000016> "bremsstrahlung process"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000016> <http://purl.obolibrary.org/obo/RBO_00015006>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000018> (radiation source)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000018> "An object aggregate that consists of a collection of subatomic particles emitted from the same radiation source.")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000018> "radiation source"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000018> <http://purl.obolibrary.org/obo/BFO_0000027>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000019> (spectrum)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000019> "A quality that is the distribution of energies of the constituent subatomic particles that constitute a radiation emission.")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000019> "spectrum"@en)
AnnotationAssertion(rdfs:seeAlso <http://purl.archive.org/purl/rto-draft/RTO_0000019> "http://purl.obolibrary.org/obo/CHMO_0000800.  A plot of a measured quantity against some experimental parameter.")
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000019> <http://purl.obolibrary.org/obo/PATO_0001018>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000020> (radiation beam)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000020> "A radiation source that has been produced or modified so that its constituent elements are moving in a given direction with a given energy spectrum.")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000020> "radiation beam"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000020> <http://purl.archive.org/purl/rto-draft/RTO_0000018>)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000020> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000086> <http://purl.archive.org/purl/rto-draft/RTO_0000019>))

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000021> (medical linear accelerator)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000021> "A radiotherapy device that is designed to produce ionizing radiation for therapeutic purposes and whose radiation source consists of a monoenergetic beam of electrons that are accelerated in a linear waveguide.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000118> <http://purl.archive.org/purl/rto-draft/RTO_0000021> "\"linac\", \"linear accelerator\"")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000021> "medical linear accelerator"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000021> <http://purl.archive.org/purl/rto-draft/RTO_0000006>)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000021> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000056> <http://purl.archive.org/purl/rto-draft/RTO_0000016>))

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000023> (Iodine-125)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000023> "An isotope of iodine with A=125, Z=53")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000118> <http://purl.archive.org/purl/rto-draft/RTO_0000023> "I-125")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000023> "Iodine-125"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000023> <http://purl.archive.org/purl/rto-draft/RTO_0000011>)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000023> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000056> <http://purl.archive.org/purl/rto-draft/RTO_0000008>))

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000024> (Iridium-192)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000024> "An isotope of iridium with A=192, Z=77")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000118> <http://purl.archive.org/purl/rto-draft/RTO_0000024> "Ir-192")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000024> "Iridium-192"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000024> <http://purl.archive.org/purl/rto-draft/RTO_0000011>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000025> (Cobalt-60)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000025> "An isotope of cobalt with A=60, Z=27")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000118> <http://purl.archive.org/purl/rto-draft/RTO_0000025> "Co-60")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000025> "Cobalt-60"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000025> <http://purl.archive.org/purl/rto-draft/RTO_0000011>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000026> (Cesium-137)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000026> "An isotope of cesium with A=137, Z=55")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000118> <http://purl.archive.org/purl/rto-draft/RTO_0000026> "Cs-137")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000026> "Cesium-137"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000026> <http://purl.archive.org/purl/rto-draft/RTO_0000011>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000027> (alpha decay)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000027> "Nuclear decay in which an alpha particle is emitted.")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000027> "alpha decay"@en)
AnnotationAssertion(rdfs:seeAlso <http://purl.archive.org/purl/rto-draft/RTO_0000027> "RBO_00015004")
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000027> <http://purl.obolibrary.org/obo/RBO_00002118>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000030> (target volume)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000030> "A site that denotes a region of the body that contains disease that is to be irradiated during a radiation therapy procedure.")
AnnotationAssertion(rdfs:comment <http://purl.archive.org/purl/rto-draft/RTO_0000030> "According to Arp et al, a site is relative to another body.  Examples given are the hold of a ship or the interior of a railcar.  They can move through space, as opposed to a spatial region which is immovable.  This seems appropriate for the region containing a tumor.")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000030> "target volume"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000030> <http://purl.obolibrary.org/obo/BFO_0000029>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000031> (clinical target volume)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000031> "A target volume that encompasses the tissue that contains the gross tumor volume plus tissue that is suspected to contain microscopic tumor.")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000031> "clinical target volume"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000031> <http://purl.archive.org/purl/rto-draft/RTO_0000030>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000032> (gross tumor volume)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000032> "A target volume that encompasses the tissue that contains macroscopic tumor or other tissue that is intended to be irradiated.")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000032> "gross tumor volume"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000032> <http://purl.archive.org/purl/rto-draft/RTO_0000030>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000033> (planning target volume)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000033> "A target volume that contains the gross tumor volume and clinical target volume (if it exists) and a margin to account for uncertainty in setting up the patient for irradiation.")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000033> "planning target volume"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000033> <http://purl.archive.org/purl/rto-draft/RTO_0000030>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000034> (dose volume histogram)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000034> "A histogram that displays the volume of a region of interest that receives a given dose during radiation therapy.")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000034> "dose volume histogram"@en)
AnnotationAssertion(rdfs:seeAlso <http://purl.archive.org/purl/rto-draft/RTO_0000034> "DVH")
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000034> <http://purl.obolibrary.org/obo/IAO_0000179>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000035> (radiation therapy prescription)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000035> "An objective specification that describes the dosimetric and fractionation objectives of a radiation therapy treatment.")
AnnotationAssertion(rdfs:comment <http://purl.archive.org/purl/rto-draft/RTO_0000035> "Example: Total body irradiation to 13.2 Gy in 8 fractions of 1.65 Gy BID with lung blocks and no testicular boost.")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000035> "radiation therapy prescription"@en)
AnnotationAssertion(rdfs:seeAlso <http://purl.archive.org/purl/rto-draft/RTO_0000035> "A verbal or written order given by an authorized person instructing a patient to obtain and use a medical device, prescription or undergo a procedure. [Definition Source: NCI]
http://purl.obolibrary.org/obo/NCIT_C28180")
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000035> <http://purl.obolibrary.org/obo/IAO_0000005>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000036> (radiation therapy method)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000036> "An action specification that describes the method of irradiation in the domain of radiation therapy.")
AnnotationAssertion(rdfs:comment <http://purl.archive.org/purl/rto-draft/RTO_0000036> "Example: 7 field IMRT with 6 MV photons.")
AnnotationAssertion(rdfs:comment <http://purl.archive.org/purl/rto-draft/RTO_0000036> "Examples: [3D conformal radiation with parallel opposed 18 MV x-rays], [en face 10 MeV electron field]")
AnnotationAssertion(rdfs:comment <http://purl.archive.org/purl/rto-draft/RTO_0000036> "This class can encompass what is sometimes called \"modality\" or \"technique\", both of which are terms that are often inconsistent, incomplete and not common across the entire community.  However, it does need to be complete enough so that when coupled with a prescription, provides sufficient information to be concretized as a protocol and eventually realized as a process.")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000036> "radiation therapy method"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000036> <http://purl.obolibrary.org/obo/IAO_0000007>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000037> (radiation therapy protocol)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000037> "A plan specification that describes radiation therapy methods and prescriptions as applicable to certain patient classes.")
AnnotationAssertion(rdfs:comment <http://purl.archive.org/purl/rto-draft/RTO_0000037> "Example: The elements of a clinical study that details the manner in which radiation therapy will be applied as part of that study.
Example: NRG-LU008 is a clinical study for people with non-small cell lung cancer (NSCLC) that has spread to the lymph nodes in the chest and is not able to be treated by surgery. The radiation therapy protocol of this research study details the use of SBRT.")
AnnotationAssertion(rdfs:comment <http://purl.archive.org/purl/rto-draft/RTO_0000037> "This class name uses the term \"protocol\" in a general sense that also includes research protocols and institution-specific therapy protocols.")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000037> "radiation therapy protocol"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000037> <http://purl.obolibrary.org/obo/IAO_0000104>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000038> (radiation therapy plan specification)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000038> "A plan specification that has parts radiation therapy method and radiation therapy prescription and provides details required for its realization in a plan and subsequent concretization in a radiation therapy treatment.")
AnnotationAssertion(rdfs:comment <http://purl.archive.org/purl/rto-draft/RTO_0000038> "Following the discussion Arp et al, this class can be instantiated in multiple ways and is not meant to be restrictive to a particular mode, such as a printout or set of DICOM objects.")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000038> "radiation therapy plan specification"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000038> <http://purl.obolibrary.org/obo/IAO_0000104>)

# Class: <http://purl.archive.org/purl/rto-draft/RTO_0000039> (radiation therapy course)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.archive.org/purl/rto-draft/RTO_0000039> "A healthcare process that uses ionizing radiation to treat a condition within the body as the realization of a plan that concretized a radiation therapy plan specification.")
AnnotationAssertion(rdfs:label <http://purl.archive.org/purl/rto-draft/RTO_0000039> "radiation therapy course"@en)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000039> <http://purl.obolibrary.org/obo/OGMS_0000096>)
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000039> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000055> <http://purl.obolibrary.org/obo/OBI_0000260>))
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000039> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000057> <http://purl.archive.org/purl/rto-draft/RTO_0000035>))
SubClassOf(<http://purl.archive.org/purl/rto-draft/RTO_0000039> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000057> <http://purl.obolibrary.org/obo/RTO_0000082>))

# Class: <http://purl.obolibrary.org/obo/RBO_00015005> (beta decay)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RBO_00015005> "beta decay")
SubClassOf(<http://purl.obolibrary.org/obo/RBO_00015005> <http://purl.obolibrary.org/obo/RBO_00002118>)

# Class: <http://purl.obolibrary.org/obo/RTO_0000079> (radiation therapy session)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/RTO_0000079> "A health care process in which a single fraction of the prescribed radiation dose is delivered to a patient as part of a process designed to treat a disease.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RTO_0000079> "radiation therapy session"@en)
SubClassOf(<http://purl.obolibrary.org/obo/RTO_0000079> <http://purl.obolibrary.org/obo/OGMS_0000096>)
SubClassOf(<http://purl.obolibrary.org/obo/RTO_0000079> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000055> <http://purl.obolibrary.org/obo/OBI_0000260>))
SubClassOf(<http://purl.obolibrary.org/obo/RTO_0000079> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000057> <http://purl.obolibrary.org/obo/RTO_0000081>))

# Class: <http://purl.obolibrary.org/obo/RTO_0000080> (fractional dose)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/RTO_0000080> "A radiation dose that is realized as part of a radiation therapy process and occurs during a radiation therapy session.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RTO_0000080> "fractional dose"@en)
SubClassOf(<http://purl.obolibrary.org/obo/RTO_0000080> <http://purl.obolibrary.org/obo/RBO_010016>)

# Class: <http://purl.obolibrary.org/obo/RTO_0000081> (radiation therapy fractional dose)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/RTO_0000081> "An objective specification denoting the desired dose per radiation therapy session.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RTO_0000081> "radiation therapy fractional dose"@en)
SubClassOf(<http://purl.obolibrary.org/obo/RTO_0000081> <http://purl.obolibrary.org/obo/IAO_0000005>)

# Class: <http://purl.obolibrary.org/obo/RTO_0000082> (radiation therapy total dose)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/RTO_0000082> "An objective specification denoting the total desired dose delivered during a radiation therapy course and is the sum of the fractional doses delivered in the sequence of radiation therapy sessions.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RTO_0000082> "radiation therapy total dose"@en)
SubClassOf(<http://purl.obolibrary.org/obo/RTO_0000082> <http://purl.obolibrary.org/obo/IAO_0000005>)


