    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000001</IRI>
        <Literal>A device that limits the 2D spatial extent of the fluence of subatomic particles.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000001</IRI>
        <Literal>Mark Phillips</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000001</IRI>
        <Literal xml:lang="en">collimator</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000002</IRI>
        <Literal>A device that has been constructed so as to emit subatomic particles.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000002</IRI>
        <Literal>Radiation source refers to the device that actually produces the radiation independent of the application to radiation therapy.  For example, a linear accelerator operating in the megavoltage regime produces a beam of x-rays by accelerating electrons and using them to create bremmstrahlung.  Such a device can be attached to some sort of flexible armature for positioning and outfitted with dose monitors and electronic feedback circuits, etc to make a radiation therapy device.  Other examples are manufactured Co-60 pellets, proton cyclotrons, etc.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000002</IRI>
        <Literal xml:lang="en">radiation device</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000003</IRI>
        <Literal>A device that is used to position a patient during a health care process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000003</IRI>
        <Literal>Such a device is  also often used to partially or completely immobilize the patient during the process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000003</IRI>
        <Literal xml:lang="en">patient positioner</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000005</IRI>
        <Literal>A device that is used to deliver radiation therapy to a patient.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000005</IRI>
        <Literal>Mark Phillips</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000005</IRI>
        <Literal xml:lang="en">radiation therapy device</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000006</IRI>
        <Literal>A radiation therapy device in that generaties ionizing radiation outside of the body and the radiation passes from the source through space and parts of the body in order to irradiate the desired target tissue.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000006</IRI>
        <Literal>Mark Phillips</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000006</IRI>
        <Literal xml:lang="en">external therapy device</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000007</IRI>
        <Literal>A radiation therapy device that relies on ionizing radiation generated within the body.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000007</IRI>
        <Literal>Mark Phillips</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000007</IRI>
        <Literal xml:lang="en">brachytherapy device</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000008</IRI>
        <Literal>The radioactive decay process by which an atom&apos;s inner orbital electron is absorbed within the nucleus followed by conversion of a proton to a neutron and emission of a neutrino.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000008</IRI>
        <Literal xml:lang="en">electron capture</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000009</IRI>
        <Literal>A subatomic process in which a nucleus moves to a lower energy state by the emission of a photon.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000009</IRI>
        <Literal xml:lang="en">gamma emission</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000010</IRI>
        <Literal>An atom that contains a specific number of neutrons and a specific atomic mass.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000010</IRI>
        <Literal>Elements are defined as atoms with a specific  number of protons in the nucleus.  The number of neutrons can vary, with each variation denoting a specific isotope of that element.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000010</IRI>
        <Literal>NCI</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000010</IRI>
        <Literal xml:lang="en">isotope</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000011</IRI>
        <Literal>An isotope that undergoes radioactive decay.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000011</IRI>
        <Literal xml:lang="en">radioactive isotope</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000013</IRI>
        <Literal>A radiation source that has a radioactive isotope as the source of subatomic particles.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000013</IRI>
        <Literal>Needs object property &quot;has part&quot; and then should be stated &quot;has part radioactive isotope&quot;.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000013</IRI>
        <Literal xml:lang="en">radioactive isotopic source</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000016</IRI>
        <Literal>The process by which a charged particle emits radiation due to its acceleration caused by an electric field.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000016</IRI>
        <Literal xml:lang="en">bremsstrahlung process</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000018</IRI>
        <Literal>An objective specification that is the dose intended to be delivered during radiation therapy.  It is a part of radiation therapy prescription.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000018</IRI>
        <Literal xml:lang="en">radiation therapy prescribed dose</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000019</IRI>
        <Literal>A quality that is the distribution of energies of the constituent subatomic particles that constitute a radiation emission.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000019</IRI>
        <Literal xml:lang="en">spectrum</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:seeAlso"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000019</IRI>
        <Literal>http://purl.obolibrary.org/obo/CHMO_0000800.  A plot of a measured quantity against some experimental parameter.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000020</IRI>
        <Literal>An object aggregate  that that consists of a collection of subatomic particles that are moving in a given direction with a given energy spectrum.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000020</IRI>
        <Literal xml:lang="en">radiation beam</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000021</IRI>
        <Literal>A radiotherapy device that is designed to produce ionizing radiation for therapeutic purposes and whose radiation source consists of a monoenergetic beam of electrons that are accelerated in a linear waveguide.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000118"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000021</IRI>
        <Literal>&quot;linac&quot;, &quot;linear accelerator&quot;</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000021</IRI>
        <Literal>Most medical linear accelerators have two modes: electron and photon. If the electrons are steered into a high Z target, bremsstrahlung will result in x-rays which can then be used to treat.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000021</IRI>
        <Literal xml:lang="en">medical linear accelerator</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000022</IRI>
        <Literal>An objective specification that is the intended number of radiation therapy fractions to be delivered in a course of radiation therapy.  It is part of radiatiuon therapy prescription.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000022</IRI>
        <Literal xml:lang="en">radiation therapy prescribed fraction</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000023</IRI>
        <Literal>An isotope of iodine with A=125, Z=53</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000118"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000023</IRI>
        <Literal>I-125</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000023</IRI>
        <Literal xml:lang="en">Iodine-125</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000024</IRI>
        <Literal>An isotope of iridium with A=192, Z=77</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000118"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000024</IRI>
        <Literal>Ir-192</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000024</IRI>
        <Literal xml:lang="en">Iridium-192</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000025</IRI>
        <Literal>An isotope of cobalt with A=60, Z=27</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000118"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000025</IRI>
        <Literal>Co-60</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000025</IRI>
        <Literal xml:lang="en">Cobalt-60</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000026</IRI>
        <Literal>An isotope of cesium with A=137, Z=55</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000118"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000026</IRI>
        <Literal>Cs-137</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000026</IRI>
        <Literal xml:lang="en">Cesium-137</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000030</IRI>
        <Literal>A site that denotes a region of the body that contains disease that is to be irradiated during a radiation therapy procedure.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000030</IRI>
        <Literal>According to Arp et al, a site is relative to another body.  Examples given are the hold of a ship or the interior of a railcar.  They can move through space, as opposed to a spatial region which is immovable.  This seems appropriate for the region containing a tumor.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000030</IRI>
        <Literal xml:lang="en">target volume</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000031</IRI>
        <Literal>A target volume that encompasses the tissue that contains the gross tumor volume plus tissue that is suspected to contain microscopic tumor.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000031</IRI>
        <Literal xml:lang="en">clinical target volume</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000032</IRI>
        <Literal>A target volume that encompasses the tissue that contains macroscopic tumor or other tissue that is intended to be irradiated.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000032</IRI>
        <Literal xml:lang="en">gross tumor volume</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000033</IRI>
        <Literal>A target volume that contains the gross tumor volume and clinical target volume (if it exists) and a margin to account for uncertainty in setting up the patient for irradiation.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000033</IRI>
        <Literal xml:lang="en">planning target volume</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000034</IRI>
        <Literal>A histogram that displays the volume of a region of interest that receives a given dose during radiation therapy.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000034</IRI>
        <Literal xml:lang="en">dose volume histogram</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:seeAlso"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000034</IRI>
        <Literal>DVH</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000035</IRI>
        <Literal>An objective specification that describes the dosimetric and fractionation objectives of a radiation therapy treatment.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000035</IRI>
        <Literal>Example: Total body irradiation to 13.2 Gy in 8 fractions of 1.65 Gy BID with lung blocks and no testicular boost.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000035</IRI>
        <Literal xml:lang="en">radiation therapy prescription</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:seeAlso"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000035</IRI>
        <Literal>A verbal or written order given by an authorized person instructing a patient to obtain and use a medical device, prescription or undergo a procedure. [Definition Source: NCI]
http://purl.obolibrary.org/obo/NCIT_C28180</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000036</IRI>
        <Literal>An action specification that describes the method of irradiation in the domain of radiation therapy.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000036</IRI>
        <Literal>Example: 7 field IMRT with 6 MV photons.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000036</IRI>
        <Literal>Examples: [3D conformal radiation with parallel opposed 18 MV x-rays], [en face 10 MeV electron field]</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000036</IRI>
        <Literal>This class can encompass what is sometimes called &quot;modality&quot; or &quot;technique&quot;, both of which are terms that are often inconsistent, incomplete and not common across the entire community.  However, it does need to be complete enough so that when coupled with a prescription, provides sufficient information to be concretized as a protocol and eventually realized as a process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000036</IRI>
        <Literal xml:lang="en">radiation therapy method</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000037</IRI>
        <Literal>A plan specification that describes radiation therapy methods and prescriptions as applicable to certain patient classes.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000037</IRI>
        <Literal>Example: The elements of a clinical study that details the manner in which radiation therapy will be applied as part of that study.
Example: NRG-LU008 is a clinical study for people with non-small cell lung cancer (NSCLC) that has spread to the lymph nodes in the chest and is not able to be treated by surgery. The radiation therapy protocol of this research study details the use of SBRT.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000037</IRI>
        <Literal>This class name uses the term &quot;protocol&quot; in a general sense that also includes research protocols and institution-specific therapy protocols.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000037</IRI>
        <Literal xml:lang="en">radiation therapy protocol</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000038</IRI>
        <Literal>A plan specification that has parts radiation therapy method and radiation therapy prescription and provides details required for its realization in a plan and subsequent concretization in a radiation therapy treatment.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000038</IRI>
        <Literal>Following the discussion Arp et al, this class can be instantiated in multiple ways and is not meant to be restrictive to a particular mode, such as a printout or set of DICOM objects.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000038</IRI>
        <Literal xml:lang="en">radiation therapy plan specification</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000039</IRI>
        <Literal>A radiation therapy procedure that uses ionizing radiation to treat a condition within the body as the realization of a plan that concretized a radiation therapy plan specification.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000039</IRI>
        <Literal xml:lang="en">radiation therapy treatment</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000040</IRI>
        <Literal>A set of values that of relevant machine parameters that represent the physical state of a radiation therapy device at a given  moment.  A temporally-ordered set of control points can be used to document changes in the state, e.g. movement of a gantry, change in monitor units.  The exact set of measurements  needed may depend on the radiation therapy device and the intended use of them.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000040</IRI>
        <Literal xml:lang="en">control_point</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000044</IRI>
        <Literal xml:lang="en">volume measurement datum</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000088</IRI>
        <Literal>A device used in a radiation therapy process that modulates the dose deposited by a radiation beam in order to better conform the dose distribution to the target volume.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000088</IRI>
        <Literal xml:lang="en">compensator</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000089</IRI>
        <Literal>A compensator that modulates the dose distribution of a beam of x-rays by varying the fluence of x-rays across the beam profile.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000089</IRI>
        <Literal xml:lang="en">x-ray compensator</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000090</IRI>
        <Literal>A compensator that modulates the dose distribution of a beam of charged particles by varying the energy of the particles across the beam profile.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000090</IRI>
        <Literal xml:lang="en">charged particle compensator</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000091</IRI>
        <Literal>An x-ray compensator that modulates the x-ray fluence in one dimension across the beam profile.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000091</IRI>
        <Literal xml:lang="en">wedge</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000092</IRI>
        <Literal>A collimator that limits the extent of the irradiated field by means of multiple pieces of hardware whose positions in the radiation beam can be varied so as to achieve the desired beam profile.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000092</IRI>
        <Literal xml:lang="en">multileaf collimator</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000093</IRI>
        <Literal>An image creation device in which a volume of tissue is simultaneously exposed to x-rays, captured by a 2-dimensional screen, and a series of tomographic image slices are computed.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000093</IRI>
        <Literal xml:lang="en">cone beam computed tomography scanner</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:seeAlso"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000093</IRI>
        <Literal>CBCT
Cone beam CT</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000094</IRI>
        <Literal>An image creation device in which tomographic images are obtained through the use of radiofrequency waves, large homogeneous magnetic field and magnetic field gradients.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000094</IRI>
        <Literal xml:lang="en">magnetic resonance tomographic scanner</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:seeAlso"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0000094</IRI>
        <Literal>MRI
MR scanner</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0001008</IRI>
        <Literal xml:lang="en">has specified timestamp value</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0001024</IRI>
        <Literal>A health care process which prepares a patient for radiation therapy treatment by means of imaging, localization and may include the manufacture of localization devices.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0001024</IRI>
        <Literal xml:lang="en">radiation therapy simulation</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0001025</IRI>
        <Literal>A radiation therapy procedure that consists of a single episode (fraction) of the delivery of radiation therapy.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0001025</IRI>
        <Literal>A radiation therapy treatment consists of 1 or more radiation therapy sessions.
Each session is bounded by the entrance to a treatment room until the prescribed treatment has been executed and the patient leaves the room.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0001025</IRI>
        <Literal xml:lang="en">radiation therapy session</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0001026</IRI>
        <Literal>A medical imaging process that is used in radiation therapy procedures.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0001026</IRI>
        <Literal>This definition encompasses imaging (CBCT, surface imaging, etc) for positioning the patient for treatment but can also include imaging such as MRI for treatment planning.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0001026</IRI>
        <Literal xml:lang="en">radiation therapy imaging</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0001027</IRI>
        <Literal>A radiation therapy imaging process that utilizes cone beam CT imaging in order to visualize the appropriate anatomy and matching that to the planning images.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://purl.archive.org/purl/rto-draft/RTO_0001027</IRI>
        <Literal xml:lang="en">cone beam computed tomography</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
